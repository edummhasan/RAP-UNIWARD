# Copy to config/local.env, edit for your host, then: source config/local.env
# Generate and store the three independent keys separately; do not commit them.
export RAP_BACKEND=CPU
export RAP_BALANCE_PROFILE=B
export RAP_REPORT_DIR=results
export INPUT_DIR=input
export MSG_DIR=msg
export OUTPUT_DIR=output
export GEOMETRIES=ALL_GEOMETRY
export STC_HEIGHT=10
export WORKERS=auto
export THREAD_MODE=virtual
export CPU_SLOTS=4
export CARRIER_PARALLELISM=4
export RAP_PREPARED_CACHE_STATES=8
export RAP_SOURCE_CACHE_IMAGES=1
export RAP_QF_PREFETCH_DEPTH=0
export RAP_QF_PREFETCH_WORKERS=1
export AUDIT_ENABLED=true
export AUDIT_MODE=RESULT_ONLY
export AUDIT_PROFILE=THESIS
export RESUME=false
export CONTINUE_ON_ERROR=true
export DELETE_JPEGS_AFTER_EVALUATION=false
export JAVA_OPTS='-Djava.awt.headless=true -XX:MaxRAMPercentage=70.0'
# Optional: CPU_AFFINITY=0-27 (must be valid on the host)
